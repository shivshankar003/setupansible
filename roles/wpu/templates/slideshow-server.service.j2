[Unit]
Description=WPU slideshow — server mode (online recognition + slideshow)
After=network-online.target
Wants=network-online.target
Conflicts=slideshow-diagnostic.service slideshow-only.service

[Service]
Type=simple
User={{ wpu_user }}
WorkingDirectory={{ wpu_project_dir }}
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart={{ wpu_project_dir }}/.venv/bin/python main.py --service all
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
