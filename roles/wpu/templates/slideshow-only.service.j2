[Unit]
Description=WPU slideshow — display only
Conflicts=slideshow-server.service slideshow-diagnostic.service

[Service]
Type=simple
User={{ wpu_user }}
WorkingDirectory={{ wpu_project_dir }}
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart={{ wpu_project_dir }}/.venv/bin/python main.py --service slideshow
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
